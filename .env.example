# Copy this file to ".env" and fill in the key. Never commit the real .env.

# Google Gemini API key (https://aistudio.google.com/ -> "Get API key").
# Without it the demo still runs: summaries and answers use the built-in fallback.
GEMINI_API_KEY=

# Optional: override the model if Google renames it.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: protect the operator panel. Then open /operator?key=<this value>
# OPERATOR_KEY=

# Optional: port (hosting platforms usually set this themselves).
# PORT=8000
